# Nakili faili hii kuwa `.env` kwa ajili ya development ya ndani.
#   copy .env.example .env
#
# `.env` haiendi kwenye git (ipo kwenye .gitignore) wala kwenye Render.
# Setting za Render zimewekwa kwenye dashibodi na hazitaguswa na faili hii.

# --- Development ------------------------------------------------------------
DEBUG=True
SECRET_KEY=dev-only-badilisha-kabla-ya-production
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000

# Database ya ndani. SQLite inatosha kwa development.
# Ukitaka kutumia data halisi ya Supabase, badilisha na anwani kamili yake.
DATABASE_URL=sqlite:///db.sqlite3

# --- Pesapal ----------------------------------------------------------------
# ACHA HIZI TUPU kwa development. Zikiwa tupu, `pesapal.is_configured()`
# inarudisha False na kurasa za malipo zinaonyesha ujumbe badala ya kujaribu
# kutuma mtu Pesapal — hakuna hatari ya kugusa pesa halisi ukiwa unatengeneza.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=v6YyU8CdkXEQqAA2iAnON+wUaeo+mZUX
PESAPAL_CONSUMER_SECRET=2PWaymjkY8NAD5QuoMKtIar8oW8=
PESAPAL_IPN_ID=cf2142a4-fb9f-476d-bb9c-d9f183b16645

# --- Selcom -----------------------------------------------------------------
# ACHA TUPU kwa development. Zikiwa tupu, `selcom.is_configured()`
# inarudisha False na ukurasa unaonyesha ujumbe badala ya kujaribu
# kutuma kidokezo — hakuna hatari ya kugusa pesa halisi.
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=

# --- SMS (NextSMS) ----------------------------------------------------------
# Kwa development, ACHA TUPU. `is_configured()` inarudisha False na hakuna
# SMS itakayotumwa — wala code haitaulizwa wakati wa kuingia.
#
# Ukitaka kujaribu SMS bila kutumia salio, weka token na sender kisha
# NEXTSMS_TEST_MODE=True — NextSMS itarudisha jibu la kweli bila kutuma.
NEXTSMS_TOKEN=
NEXTSMS_SENDER=
NEXTSMS_TEST_MODE=True
LOGIN_OTP_ENABLED=True
